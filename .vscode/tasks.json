{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OpenCV edge detector",
      "type": "process",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}\\main.cpp",
        "-o",
        "${workspaceFolder}\\build\\Debug\\outDebug.exe",
        "-IC:\\msys64\\mingw64\\include\\opencv5",
        "-LC:\\msys64\\mingw64\\lib",
        "-lopencv_highgui",
        "-lopencv_imgcodecs",
        "-lopencv_imgproc",
        "-lopencv_core"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
